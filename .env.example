# Copy to .env and fill in real values. .env itself is gitignored — this
# file is the only thing that travels with the repo, so nothing secret
# belongs in here (see README "내부 서버 배포").

# --- Frontend build (Dockerfile ARG / vite dev server) ---
# Leave empty ("") for the docker-compose nginx setup — nginx.conf reverse-proxies
# /api/** to the backend container, so the SPA calls its own origin, no
# separate backend URL needed. Only set a real URL (e.g. http://localhost:8080)
# for `npm run dev` against a backend that ISN'T behind that proxy.
VITE_API_BASE=

# --- docker-compose.yml: backend container ---
# Point at a MariaDB you already run (not a bundled DB container). Defaults
# match career-backend's own schema/seed expectations (career_db / career_app).
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=career_db
DB_USER=career_app
DB_PASSWORD=career_app

# Comma-separated. Only matters for requests that DON'T go through the nginx
# proxy above (e.g. hitting the backend directly) — still worth setting to
# the real deployed origin(s) as defense-in-depth.
CAREER_MATE_ALLOWED_ORIGINS=http://localhost

# Generate a real one before deploying anywhere but a laptop, e.g.:
#   openssl rand -base64 48
JWT_SECRET=

# 자소서 첨삭(EssayReviewService) / AI 상담(AiChatService)용 — 비어있으면
# 백엔드가 503("AI 기능이 아직 설정되지 않았습니다")으로 명확히 응답함.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- docker-compose.yml: host port mappings ---
BACKEND_PORT=8080
FRONTEND_PORT=80
